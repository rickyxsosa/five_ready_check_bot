# Get this from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Chat ids the bot works in, comma-separated. Empty = any chat.
# Find yours in the log line "ready check in chat -100..." after a /dota.
ALLOWED_CHAT_IDS=
# How many players /dota waits for by default
PLAYERS_NEEDED=5
# Close a ready check this many hours after it was posted
EXPIRE_HOURS=6
# Ping anyone still on "Soon" after this many minutes, if the group is short
SOON_NUDGE_MINUTES=15
