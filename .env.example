# Get this from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Chat ids the bot works in, comma-separated. Empty = any chat.
# Find yours in the log line "ready check in chat -100..." after a /readycheck.
ALLOWED_CHAT_IDS=
# Default player count for a game the bot has not seen yet
PLAYERS_NEEDED=5
# Local time (HH:MM) each night when open ready checks close, in the TZ timezone
EXPIRE_AT=00:30
TZ=America/Los_Angeles
# Ping anyone still on "Soon" after this many minutes, if the group is short
SOON_NUDGE_MINUTES=30
